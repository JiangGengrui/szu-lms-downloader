{
  "manifest_version": 3,
  "name": "畅课课件下载助手",
  "version": "1.0.0",
  "description": "深圳大学畅课平台（lms.szu.edu.cn）课件下载工具。监听课件预览请求，一键下载老师未开放下载权限的课件，支持离线学习与课件归档。",
  "author": "SZUser",
  "permissions": [
    "webRequest",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://lms.szu.edu.cn/*",
    "*://media2.szu.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "畅课课件下载助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://lms.szu.edu.cn/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
